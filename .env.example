NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_FETCH_TIMEOUT_MS=3500
NEXT_PUBLIC_SUPABASE_FETCH_COOLDOWN_MS=5000
NEXT_PUBLIC_SUPABASE_WRITE_TIMEOUT_MS=45000
SUPER_ADMIN_ACCOUNT=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_VERIFICATION_EMAIL=
SUPER_ADMIN_VERIFICATION_SECRET=

# Optional: enable booking confirmation emails on first confirm only.
RESEND_API_KEY=
BOOKING_CONFIRMATION_EMAIL_FROM=
BOOKING_CONFIRMATION_EMAIL_REPLY_TO=

# Optional: connect Google Business Profile reviews in the website editor.
# Use a Web application OAuth client and register the callback URI exactly.
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_TOKEN_KEY=
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=https://www.faolla.com/api/google-business-profile/callback
GOOGLE_BUSINESS_PROFILE_SYNC_INTERVAL_MS=900000

# Optional: shadow-write successful legacy order mutations to the V1 order tables.
# Keep disabled until migrations 202607250001 and 202607250002 are applied and verified.
MERCHANT_ORDER_V1_DUAL_WRITE_MODE=off
MERCHANT_ORDER_V1_DUAL_WRITE_TIMEOUT_MS=2500
# Optional: compare or read V1 orders for explicitly allowlisted merchants.
# Production builds validate this complete configuration before switching a
# release. Invalid or unsafe combinations fail closed instead of being silently
# normalized by the request path.
# Modes: off, verify (always returns legacy), primary (returns V1 only on exact parity).
MERCHANT_ORDER_V1_READ_MODE=off
MERCHANT_ORDER_V1_READ_SITE_IDS=
MERCHANT_ORDER_V1_READ_TIMEOUT_MS=2500
# Optional process-local protection for an approved primary-read canary.
# Keep false during off/verify and until the Stage 12 rollout gate is ready.
MERCHANT_ORDER_V1_PRIMARY_CIRCUIT_BREAKER_ENABLED=false
MERCHANT_ORDER_V1_PRIMARY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
MERCHANT_ORDER_V1_PRIMARY_CIRCUIT_BREAKER_WINDOW_MS=60000
MERCHANT_ORDER_V1_PRIMARY_CIRCUIT_BREAKER_COOLDOWN_MS=300000
# Required only for a primary-read deployment. Use check:v1-rollout-gate for
# the first activation, then issue:v1-primary-continuation-approval for later
# deployments while the primary canary remains healthy. Both commands append
# an audit JSONL beside the receipt by default. Use at least 32 random bytes for
# the key, keep it secret, and store the receipt in the shared runtime directory
# so an isolated release build can read it.
MERCHANT_ORDER_V1_ROLLOUT_APPROVAL_KEY=
MERCHANT_ORDER_V1_ROLLOUT_APPROVAL_RECEIPT_FILE=
# Optional Stage 15 scheduled canary watchdog. Keep disabled in the web
# process. Enable only in the scheduler shell that runs the one-shot watch
# command. The webhook must use HTTPS; the bearer token is optional.
MERCHANT_ORDER_V1_PRIMARY_CANARY_WATCH_ENABLED=false
MERCHANT_ORDER_V1_PRIMARY_CANARY_ALERT_WEBHOOK_URL=
MERCHANT_ORDER_V1_PRIMARY_CANARY_ALERT_BEARER_TOKEN=
# One-command operator guard. Keep false in deployed environments and set true
# only in the shell running an explicitly confirmed order backfill.
ORDER_V1_BACKFILL_WRITE_ENABLED=false

# Optional: shadow-write legacy membership identities and account transactions
# into the immutable V1 ledger. Keep off until migrations 202607250001 through
# 202607250003 are applied, a dry-run backfill is clean, and the merchant is
# explicitly listed. Wildcards are intentionally unsupported.
MERCHANT_MEMBERSHIP_V1_DUAL_WRITE_MODE=off
MERCHANT_MEMBERSHIP_V1_DUAL_WRITE_SITE_IDS=
MERCHANT_MEMBERSHIP_V1_DUAL_WRITE_TIMEOUT_MS=2500
MERCHANT_MEMBERSHIP_V1_STORED_VALUE_CURRENCY=EUR
# Optional read-only parity observation for membership identities and ledger
# balances. Only "off" and "verify" are accepted. Verify always returns the
# original legacy membership snapshot.
MERCHANT_MEMBERSHIP_V1_READ_MODE=off
MERCHANT_MEMBERSHIP_V1_READ_SITE_IDS=
MERCHANT_MEMBERSHIP_V1_READ_TIMEOUT_MS=2500
# One-command operator guard. Keep false in deployed environments and set true
# only in the shell running an explicitly confirmed membership ledger backfill.
MEMBERSHIP_V1_BACKFILL_WRITE_ENABLED=false

# Optional: shadow-write legacy booking snapshots and timeline events into V1.
# Keep off until migrations 202607250001 through 202607250004 are applied, a
# dry-run backfill is clean, and the merchant is explicitly listed. Wildcards
# are intentionally unsupported.
MERCHANT_BOOKING_V1_DUAL_WRITE_MODE=off
MERCHANT_BOOKING_V1_DUAL_WRITE_SITE_IDS=
MERCHANT_BOOKING_V1_DUAL_WRITE_TIMEOUT_MS=2500
# Optional read-only parity observation for merchant booking list reads.
# Only "off" and "verify" are accepted. Verify always returns legacy data.
MERCHANT_BOOKING_V1_READ_MODE=off
MERCHANT_BOOKING_V1_READ_SITE_IDS=
MERCHANT_BOOKING_V1_READ_TIMEOUT_MS=2500
# One-command operator guard. Keep false in deployed environments and set true
# only in the shell running an explicitly confirmed booking backfill.
BOOKING_V1_BACKFILL_WRITE_ENABLED=false

# Optional: shadow-write coupon definitions, claims, redemptions, and releases
# into V1. Keep off until migrations 202607250001 through 202607250005 are
# applied, a dry-run backfill is clean, and the merchant is explicitly listed.
# Wildcards are intentionally unsupported.
MERCHANT_COUPON_V1_DUAL_WRITE_MODE=off
MERCHANT_COUPON_V1_DUAL_WRITE_SITE_IDS=
MERCHANT_COUPON_V1_DUAL_WRITE_TIMEOUT_MS=2500
# Optional read-only parity observation for merchant coupon snapshot reads.
# Only "off" and "verify" are accepted. Verify always returns legacy data.
MERCHANT_COUPON_V1_READ_MODE=off
MERCHANT_COUPON_V1_READ_SITE_IDS=
MERCHANT_COUPON_V1_READ_TIMEOUT_MS=2500
# One-command operator guard. Keep false in deployed environments and set true
# only in the shell running an explicitly confirmed coupon backfill.
COUPON_V1_BACKFILL_WRITE_ENABLED=false

# Optional: shadow-write merchant peer chat, platform support chat, contacts,
# and read cursors into Conversation V1. Keep off until migrations
# 202607250001 through 202607250006 are applied, the dry-run has no blockers,
# and the merchant is explicitly listed. Wildcards are intentionally rejected.
MERCHANT_CONVERSATION_V1_DUAL_WRITE_MODE=off
MERCHANT_CONVERSATION_V1_DUAL_WRITE_SITE_IDS=
MERCHANT_CONVERSATION_V1_DUAL_WRITE_TIMEOUT_MS=2500
# Optional read-only parity observation for the complete conversation snapshot.
# Only "off" and "verify" are accepted. Verify always returns legacy data and
# is rate-limited per merchant in each web process.
MERCHANT_CONVERSATION_V1_READ_MODE=off
MERCHANT_CONVERSATION_V1_READ_SITE_IDS=
MERCHANT_CONVERSATION_V1_READ_TIMEOUT_MS=2500
MERCHANT_CONVERSATION_V1_READ_MIN_INTERVAL_MS=60000
# One-command operator guard. Keep false in deployed environments and set true
# only in the shell running an explicitly confirmed conversation backfill.
CONVERSATION_V1_BACKFILL_WRITE_ENABLED=false

# Optional Stage 5 outbox enqueue preparation. This does not start a worker or
# replace any current business side effect. Enqueue requires shadow mode, one
# exact merchant ID, and one exact supported event type. Keep all three empty
# or off until migration 202607250007 has been applied and audited.
MERCHANT_OUTBOX_V1_ENQUEUE_MODE=off
MERCHANT_OUTBOX_V1_ENQUEUE_SITE_IDS=
MERCHANT_OUTBOX_V1_ENQUEUE_EVENT_TYPES=
MERCHANT_OUTBOX_V1_ENQUEUE_TIMEOUT_MS=2000

# One-shot operator worker guard. Never enable this in the deployed web
# process. Set true only in the shell running an explicitly confirmed worker
# command after migrations 202607250001 through 202607250008 are verified.
MERCHANT_OUTBOX_V1_WORKER_EXECUTION_ENABLED=false

# Long-running enterprise workflow automation consumer. This is a global
# production worker gate, not a merchant entitlement. Keep false until the
# worker process is deployed; while enabled it stays online and waits safely
# for migration 202608040026 before claiming any event.
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_ENABLED=false
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_POLL_INTERVAL_MS=1000
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_DISCOVERY_LIMIT=250
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_MERCHANT_SCOPE_LIMIT=50
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_BATCH_LIMIT=5
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_LEASE_SECONDS=90
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_TASK_TIMEOUT_MS=60000
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_REQUEST_TIMEOUT_MS=10000
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_FAILURE_BACKOFF_INITIAL_MS=1000
MERCHANT_ENTERPRISE_AUTOMATION_WORKER_FAILURE_BACKOFF_MAX_MS=30000

# Durable employee-invitation delivery. Keep legacy/false until migration
# 202608190033 and the invitation worker have both been deployed and verified.
# The keyring is a one-line JSON object whose values are 32-64 byte base64url keys.
MERCHANT_ENTERPRISE_INVITATION_DELIVERY_MODE=legacy
MERCHANT_ENTERPRISE_INVITATION_WORKER_ENABLED=false
MERCHANT_ENTERPRISE_INVITATION_HMAC_KEYRING_JSON=
MERCHANT_ENTERPRISE_INVITATION_HMAC_ACTIVE_KEY_ID=
MERCHANT_ENTERPRISE_INVITATION_PUBLIC_ORIGIN=
MERCHANT_ENTERPRISE_INVITATION_EMAIL_FROM=
MERCHANT_ENTERPRISE_INVITATION_EMAIL_REPLY_TO=
MERCHANT_ENTERPRISE_INVITATION_AUTH_LINK_TTL_SECONDS=3600
MERCHANT_ENTERPRISE_INVITATION_ISSUANCE_LEASE_SECONDS=3900
